name: demo

python_env: python_env.yaml

entry_points:
  main:
    command: "python demo_pipeline.py"

  serve:
    parameters:
      model_uri: {type: string, default: "models:/demo/Production"}
      port:      {type: float, default: 5001}
    command: >
      mlflow models serve
        --model-uri {model_uri}
        --port {port}
        --no-conda