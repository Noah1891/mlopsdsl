{
    "loader": {
        "path": "data/irisRaw.csv",
        "y": "churn"
    },
    "splitter": null,
    "selecter": {
        "num_feats": [
            "income",
            "score",
            "age"
        ],
        "cat_feats": [
            "city",
            "category"
        ]
    },
    "transformer": {
        "transformations": [
            {
                "transform": "fillna",
                "feature": "age",
                "param": "mean"
            },
            {
                "transform": "fillna",
                "feature": "income",
                "param": "median"
            },
            {
                "transform": "encode",
                "feature": "city",
                "param": "onehot"
            },
            {
                "transform": "encode",
                "feature": "category",
                "param": "onehot"
            },
            {
                "transform": "scale",
                "feature": "age",
                "param": "label"
            },
            {
                "transform": "scale",
                "feature": "income",
                "param": "onehot"
            },
            {
                "transform": "scale",
                "feature": "score",
                "param": "label"
            }
        ]
    },
    "modeler": {
        "usesTrainSet": false,
        "modelType": "Random Forest",
        "params": {
            "criterion": "gini",
            "n_estimators": "100",
            "max_depth": "5"
        }
    },
    "evaluator": null,
    "deployer": {
        "port": 5000
    },
    "monitorer": {
        "drift_rules": [
            {
                "feature": "age",
                "window": 500,
                "threshold": 0.05
            }
        ],
        "latency": 500
    }
}