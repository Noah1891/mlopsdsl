pipeline demo {
    load (
        csv("data/irisRaw.csv"),
        y = "churn"
    )

    split (
        test_size = 0.7,
        random_state = 42
    )

    select (
        num_features = ["age", "income", "score"],
        cat_features = ["city", "category"]
    ) 
        
    transformation (
        fillna(median),
        encode(onehot),
        scale(std)
    )
    
    model RandomForest (
        n_estimators = 100,
        max_depth = 5,
        criterion = "gini"
    )
    
    evaluation (
        accuracy = 0.8,
        precision = 0.9
    )

    deployment (
        port = 5000
    ) 

    monitoring (
        drift(feature = "age", window = 500) <= 0.05
    )
        
}