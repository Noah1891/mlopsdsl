pipeline demo {
    load (
        path = "../../../data/Titanic-Dataset.csv",
        target = "Survived"
    )

    split (
        train_size = 0.75,
        random_state = 10
    )

    select (
        features = ["Pclass", "Sex", "Age", "SibSp", "Parch", "Fare"]
    ) 
        
    transformation (
        fillna("Age", mean),
        encode("Pclass", onehot),
        encode("Sex", onehot),
        scale("Fare", std)
    )
    
    model LogReg (
        penalty = "l2",
        max_iter = 150
    )
    
    evaluation (
        accuracy,
        precision
    )     
}